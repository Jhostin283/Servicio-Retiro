{
  "info": {
    "name": "Retiros USD - Pruebas de despliegue",
    "description": "Flujo entre API de retiros y billetera USD. La colección consulta saldo directamente antes y después; el único débito lo solicita el backend de retiros al crear la solicitud. Configura las URL, usa una billetera ficticia autorizada y activa permitirDebito=SI para un solo envío.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string",
      "description": "DNS del balanceador con http:// o https://, sin barra final; también puedes usar http://localhost:3004 en local."
    },
    {
      "key": "usuarioId",
      "value": "jhostin",
      "type": "string",
      "description": "Usuario de prueba existente en billetera."
    },
    {
      "key": "cuentaDestino",
      "value": "123456789",
      "type": "string",
      "description": "Cuenta de destino ficticia para la pasarela simulada."
    },
    {
      "key": "permitirDebito",
      "value": "NO",
      "type": "string",
      "description": "Escribe SI para permitir un solo intento de USD 1; se restablece a NO antes de enviar."
    },
    {
      "key": "retiroId",
      "value": "",
      "type": "string",
      "description": "Se guarda automáticamente al crear un retiro con HTTP 201; también puedes pegar un ID existente."
    },
    {
      "key": "idNoExistente",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string",
      "description": "UUID de prueba que no debe existir en tu base de datos."
    },
    {
      "key": "baseUrlBilletera",
      "value": "http://54.167.69.62",
      "type": "string",
      "description": "Dirección de prueba de la API de billetera, sin /acceso ni barra final; confirmar con el otro equipo."
    },
    {
      "key": "saldoInicial",
      "value": "",
      "type": "string",
      "description": "Saldo capturado por la consulta previa a billetera."
    },
    {
      "key": "billeteraInicialId",
      "value": "",
      "type": "string",
      "description": "ID capturado en la consulta previa para comparar la misma billetera."
    },
    {
      "key": "usuarioSaldoInicial",
      "value": "",
      "type": "string",
      "description": "Usuario de la consulta previa."
    },
    {
      "key": "urlSaldoInicial",
      "value": "",
      "type": "string",
      "description": "Dirección de billetera usada en la consulta previa."
    },
    {
      "key": "debitoConfirmado",
      "value": "NO",
      "type": "string",
      "description": "Se activa únicamente tras un retiro COMPLETADO con ID de movimiento confirmado."
    },
    {
      "key": "usuarioRetiroConfirmado",
      "value": "",
      "type": "string",
      "description": "Usuario del último retiro completado por la colección."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('baseUrl');",
          "if (!base || !/^https?:\\/\\/.+/.test(base) || base.endsWith('/')) {",
          "  console.warn('Configura baseUrl con http:// o https://, sin barra final.');",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 - Comprobaciones sin débito",
      "item": [
        {
          "name": "Swagger disponible",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "docs"
              ]
            },
            "description": "Comprueba que Swagger responde a través del balanceador."
          },
          "response": []
        },
        {
          "name": "Historial del usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test('La respuesta es una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "pm.test('Los retiros pertenecen al usuario', function () { pm.response.json().forEach(r => pm.expect(r.usuarioId).to.eql(pm.variables.get('usuarioId'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/retiros?usuarioId={{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "retiros"
              ],
              "query": [
                {
                  "key": "usuarioId",
                  "value": "{{usuarioId}}"
                }
              ]
            },
            "description": "Consulta los retiros de usuarioId; un historial vacío también es válido."
          },
          "response": []
        },
        {
